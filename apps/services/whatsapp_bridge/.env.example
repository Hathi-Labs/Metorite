# whatsapp_bridge — environment
# Copy to .env (gitignored) and adjust. The gateway must be given the SAME
# WHATSAPP_BRIDGE_SECRET (and a WHATSAPP_BRIDGE_URL pointing at this service).

# Host:port this bridge's own HTTP API listens on (the gateway calls it here).
WHATSAPP_BRIDGE_ADDR=:8790

# The Metorite gateway base URL the bridge streams inbound messages to.
WHATSAPP_BRIDGE_GATEWAY_URL=http://localhost:8000

# Shared secret sent as X-Bridge-Secret in BOTH directions. Leave empty ONLY for
# local dev; set a long random value in production. MUST match the gateway's
# WHATSAPP_BRIDGE_SECRET.
WHATSAPP_BRIDGE_SECRET=

# SQLite file holding the paired device session(s). Treat as a secret — anyone
# with this file can send as the paired number. A sibling <path>.meta file holds
# the bridge's account↔jid + media bookkeeping.
WHATSAPP_BRIDGE_STORE=./bridge-store.db

# On-link history backfill. When true (default), a freshly paired number requests
# the larger ~1-year history sync (desktop profile) instead of the default
# ~3-month "recent" window — the same payload WhatsApp Desktop receives on link.
# Those historical messages flow through the SAME triage pipeline (persisted, but
# with post-sync hooks skipped so no auto-reply fires on old messages). Set to
# false for a lower-profile ~3-month backfill.
WHATSAPP_BRIDGE_FULL_HISTORY=true
# How many days of history to request (server ceiling is ~3 years; you only get
# what your phone still stores, and old media often no longer downloads).
WHATSAPP_BRIDGE_FULL_HISTORY_DAYS=365
