{
  "name": "operator_console",
  "version": "0.1.0",
  "private": true,
  "description": "Metorite Operator Console — the staff-only, cross-org customer-management surface (CP-8, D35). A SEPARATE Next.js app from the customer workbench: shares tables, never routes. Theming-exempt (D35.4).",
