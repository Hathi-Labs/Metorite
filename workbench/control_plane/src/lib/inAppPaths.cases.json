    { "path": "/tasks#today", "ok": true, "why": "a fragment" },
    { "path": "/people/me", "ok": true, "why": "a nested path" },
    { "path": "/a:b", "ok": true, "why": "a colon after the first slash is not a scheme" },
    { "path": "/projects?next=//evil.example", "ok": true, "why": "a double slash inside the query stays in the app" },
    { "path": "", "ok": false, "why": "empty" },
    { "path": "projects", "ok": false, "why": "no leading slash" },
    { "path": "foo", "ok": false, "why": "a relative path" },
