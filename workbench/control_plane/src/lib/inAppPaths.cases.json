{
  "_": "WS-62 CF-3: the one table of paths and verdicts that isInAppPath (inAppLink.ts) and is_in_app_path (orchestrator/in_app_path.py) must both give. Read by inAppLink.test.ts and tests/unit/test_in_app_path_twin.py.",
  "cases": [
    { "path": "/", "ok": true, "why": "the root, My Day" },
    { "path": "/projects", "ok": true, "why": "a pane" },
    { "path": "/projects?task=42", "ok": true, "why": "a pane with a query" },
    { "path": "/projects?project=6d000000-0000-4000-8000-000000000001&task=12", "ok": true, "why": "two query keys" },
    { "path": "/email?message=x", "ok": true, "why": "a record of a pane" },
    { "path": "/email?email=0f8fad5b-d9cb-469f-a165-70867728950e", "ok": true, "why": "the email deep link" },
    { "path": "/tasks#today", "ok": true, "why": "a fragment" },
    { "path": "/people/me", "ok": true, "why": "a nested path" },
    { "path": "/a:b", "ok": true, "why": "a colon after the first slash is not a scheme" },
    { "path": "/projects?next=//evil.example", "ok": true, "why": "a double slash inside the query stays in the app" },
    { "path": "", "ok": false, "why": "empty" },
    { "path": "projects", "ok": false, "why": "no leading slash" },
    { "path": "foo", "ok": false, "why": "a relative path" },
    { "path": "https://evil.example/login", "ok": false, "why": "a scheme and a host" },
    { "path": "http://evil.example", "ok": false, "why": "a scheme and a host" },
    { "path": "https:host", "ok": false, "why": "a scheme with no slashes" },
    { "path": "javascript:alert(1)", "ok": false, "why": "a script scheme" },
    { "path": "mailto:a@b.test", "ok": false, "why": "a mail scheme" },
    { "path": "//evil.example", "ok": false, "why": "a protocol-relative host" },
    { "path": "//evil.example/login", "ok": false, "why": "a protocol-relative host with a path" },
    { "path": "///evil.example", "ok": false, "why": "three slashes" },
    { "path": "/\\evil.example/login", "ok": false, "why": "a backslash the browser reads as a slash" },
    { "path": "\\\\evil.example/login", "ok": false, "why": "two backslashes" },
    { "path": "/projects\\x", "ok": false, "why": "a backslash inside the path" },
    { "path": "/projects\tx", "ok": false, "why": "a tab, which a URL parser strips" },
    { "path": "/projects\rx", "ok": false, "why": "a carriage return" },
    { "path": "/projects\nx", "ok": false, "why": "a line feed" },
    { "path": "/projects\u0000x", "ok": false, "why": "a NUL byte" },
    { "path": "/projects\u007fx", "ok": false, "why": "a DEL byte" },
    { "path": "/api/projects", "ok": false, "why": "an API route, not a page" },
    { "path": "/api", "ok": false, "why": "the API root" },
    { "path": " /projects", "ok": false, "why": "a leading space" }
  ]
}
