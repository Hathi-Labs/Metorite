# Customer Console service env — TEMPLATE.
#
# Copy to  /opt/acb/app/apps/services/customer_console/.env  (chmod 600, acb),
# fill in, then `sudo systemctl restart acb-customer-console`. Loaded by systemd
# (acb-customer-console.service, EnvironmentFile). Never commit the real file —
# it holds the Supabase DSN and the service's secrets.
#
# The Console's data plane is the dedicated Supabase Console project (D34); the
# service runs on this VPS (D47), bound to 127.0.0.1:8090.

# ── REQUIRED — you provide ────────────────────────────────────────────────────
# Supabase Console project connection string (the Mumbai project). SQLAlchemy
# URL; the service opens its own engine. Use the DIRECT connection (port 5432)
# or the session pooler — NOT the transaction pooler (the service uses
# multi-statement transactions).
CUSTOMER_CONSOLE_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST.supabase.co:5432/postgres

# GST home state code (place of supply for tax on invoices), e.g. KA, MH, DL.
CUSTOMER_CONSOLE_HOME_STATE=KA

# ── REQUIRED — generate on the box (any long random secret) ───────────────────
# Staff token presented to operator-only routes: provisioning, MANUAL
# activation, seat/credit grants. This is the credential you onboard with.
#   openssl rand -hex 32
CUSTOMER_CONSOLE_OPERATOR_TOKEN=

# Internal token the gateway Router presents on the AI-metering path.
#   openssl rand -hex 32
CUSTOMER_CONSOLE_INTERNAL_TOKEN=

# Provider-secret encryption. ANY long random secret — the service derives a
# Fernet key from it via SHA-256 (router.py::_fernet), so no special format.
#   openssl rand -hex 32
CUSTOMER_CONSOLE_ENCRYPTION_KEY=

# ── OPTIONAL ──────────────────────────────────────────────────────────────────
# Spend gate — ships OFF; leave unset for the MVP.
# CUSTOMER_CONSOLE_SPEND_GATE=

# ── RAZORPAY — DEFERRED. Leave unset. ─────────────────────────────────────────
# Manual / bank-transfer onboarding needs none of these; the paid-checkout
# (browser→Razorpay) path is a later build.
# CUSTOMER_CONSOLE_RAZORPAY_KEY_ID=
# CUSTOMER_CONSOLE_RAZORPAY_KEY_SECRET=
# CUSTOMER_CONSOLE_RAZORPAY_WEBHOOK_SECRET=
