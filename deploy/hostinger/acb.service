# The docker compose stack (postgres, redis). WS-49 BH-8.
# Until 2026-10-08 only a heredoc in bootstrap.sh made this unit, so the repo
# held no copy. vps_apply.sh now installs this file with every other unit
# (the BO-23 loop), and bootstrap.sh installs it from here.
# ⚠️ Core profile ONLY. The memory profile started Neo4j, and Neo4j answered
# on the public internet. Do not add a profile here without a fence.
# Fence: tests/unit/test_compose_ports_local.py.
[Unit]
Description=AI Company Brain (docker compose stack)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/acb/app
EnvironmentFile=/opt/acb/app/.env
# 🔴 **WS-49 BH-6a stopgap: the names that act WITHOUT the script.** The
# EnvironmentFile above is acb-writable. bash reads BASH_ENV, SHELLOPTS and PS4
# before the first line of a script, and ld.so reads LD_PRELOAD before bash
# runs at all. So no script can refuse them, and each one is root code
# execution. systemd applies UnsetEnvironment= as the LAST step, after every
# Environment= and EnvironmentFile= line (systemd.exec(5), v255). These lines
# remove each such name. The list also takes the names that a root child
# (psql, tar, git, docker, a python or node tool) reads as code or config.
# Each name here is one that no root unit needs from .env. box_hardening.md
# BH-6 removes the .env line itself, and these lines can go with it.
# Fence: tests/unit/test_backup_env_values.py (every root unit that loads an
# env file under /opt/acb carries this block).
UnsetEnvironment=BASH_ENV ENV SHELLOPTS BASHOPTS PS4 PROMPT_COMMAND BASH_XTRACEFD GLOBIGNORE CDPATH IFS
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT LD_DEBUG LD_DEBUG_OUTPUT LD_PROFILE LD_BIND_NOW
UnsetEnvironment=GCONV_PATH LOCPATH NLSPATH HOSTALIASES RESOLV_HOST_CONF MALLOC_CHECK_ OPENSSL_CONF OPENSSL_ENGINES
UnsetEnvironment=PYTHONSTARTUP PYTHONPATH PYTHONHOME PERL5LIB PERL5OPT NODE_OPTIONS RUBYOPT
UnsetEnvironment=GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM GIT_CONFIG_COUNT GIT_EXEC_PATH GIT_SSH_COMMAND
UnsetEnvironment=DOCKER_HOST DOCKER_CONTEXT DOCKER_CONFIG DOCKER_CERT_PATH DOCKER_TLS_VERIFY
UnsetEnvironment=TAR_OPTIONS PSQLRC PGSYSCONFDIR PGSERVICEFILE PGPASSFILE TMPDIR
ExecStart=/usr/bin/docker compose -f infra/docker-compose.yml --profile core up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f infra/docker-compose.yml down

[Install]
WantedBy=multi-user.target
