[Unit]
# Metorite pull-based delivery (WS-25). The box fetches its own updates.
#
# Why this exists rather than a push from CI: GitHub's runners cannot reach this
# VPS inbound. That is an UPSTREAM routing fault, measured and documented in
# deploy/hostinger/UPSTREAM-CONNECTIVITY-EVIDENCE.md (2026-07-28) and re-measured
# by WS-25 on 2026-08-05 with the same signature — `Connection timed out` AND
# `workbench=000000` from a runner, while the box answered the operator in
# ~240ms. Its conclusion: "the VPS is not at fault and cannot be fixed from
# inside." Outbound is fine (~29ms to GitHub), so delivery inverts.
#
# ⚠️ This unit is the half that was missing. `scripts/vps_pull.sh` shipped with
# WS-25; nothing ran it, so on 2026-08-26 the box sat two releases behind
# `release` while every push-path deploy "failed" against a fault it could never
# win. Worth recording: a script with no unit looks exactly like a working
# delivery path, right up until somebody compares SHAs.
Description=Metorite pull-based delivery (apply origin/release)
Documentation=file:///opt/acb/app/scripts/vps_pull.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# 🔴 **`acb`, NOT root (H-89, 2026-09-26).** This line read `User=root`, and
# that made this unit THE root writer H-89 hunted for a month. Every `npm ci`
# and `next build` on this path left root-owned files in the checkout, and the
# CI path, which connects as `acb`, then failed on them with EACCES. On
# 2026-09-26, 50220 paths under the workbench's `node_modules` were root-owned.
#
# Why `acb` is enough, measured on the box on 2026-09-26:
#   • `acb` owns /opt/acb and the checkout, so git needs no safe.directory;
#   • `acb` fetches origin already, because the CI path does exactly that;
#   • /etc/sudoers.d/acb grants `acb ALL=(ALL) NOPASSWD:ALL`, so every
#     `sudo systemctl …` in vps_apply.sh works as it does on the CI path;
#   • `acb` is in the `docker` group, which systemd applies through initgroups.
# So the pull path now runs as the SAME user as the CI path. One user writes
# the checkout, and a root-owned path in it is a defect with a name.
User=acb
Group=acb

# vps_pull.sh keeps its markers in /var/lib/acb. The directory was root-owned.
# StateDirectory= creates it for User= and, when the owner is wrong, chowns it
# recursively at start, so the first acb run can still write `last-pull-sha`.
StateDirectory=acb

# The unit's default PATH has no ~/.local/bin, so `command -v uv` fails and
# vps_apply.sh downloads uv again on every run. Same PATH as acb-gateway.
Environment=PATH=/home/acb/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Invoked through bash on purpose, matching acb-health-watchdog.service: a
# checkout that loses the executable bit (Windows contributors, archive exports)
# would otherwise fail with a bare "Permission denied" and this would silently
# never run — the exact failure mode WS-25 exists to end.
ExecStart=/bin/bash /opt/acb/app/scripts/vps_pull.sh

# 1800s, and NOT a round number picked for comfort: deploy.yml's ssh timeout says
# in terms that it is "matched to the pull unit's TimeoutStartSec", because the
# pre-migration backup alone takes ~11 minutes on the 4GB box. A shorter bound
# kills the apply MID-MIGRATION on a ladder that cannot roll back (R6) — and the
# old services keep answering afterwards, so a health check would call it fine.
TimeoutStartSec=1800

# ⚠️ Deliberately NO Restart=. This is a oneshot driven by a timer, and
# vps_pull.sh exits non-zero on a failed apply *specifically* so systemd marks
# the unit failed and `systemctl --failed` shows it. Its own comment gives the
# reason: "for two days the only signal was a red tick on a page nobody was
# watching." A Restart= would retry over the top of that signal and restore the
# silence. The timer's next tick is the retry, and it is visible.

[Install]
# Not WantedBy anything: the TIMER owns when this runs. Enabling the service
# directly would fire it once at boot and never again — which looks like working
# delivery for exactly one reboot.
