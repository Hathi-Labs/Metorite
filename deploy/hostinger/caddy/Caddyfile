# The box's Caddy config. `scripts/vps_apply.sh` installs THIS file on every
# deploy (H-60), so the repo is the source of truth. Do not edit
# /etc/caddy/Caddyfile by hand: the next deploy replaces it, and keeps the old
# copy as /etc/caddy/Caddyfile.bak.<epoch>.
#
# The apply validates this file with `caddy validate` BEFORE it installs it.
# A file that does not validate never reaches the box, and the deploy fails.
# The site keeps the config it had.
#
# Caddy auto-provisions TLS certs from Let's Encrypt on first request.
#
# ── Why every reverse_proxy carries lb_try_duration (H-60) ──────────────────
# A deploy restarts each upstream. For about one second the port refuses the
# connection, and without these lines Caddy answers that request with 502.
# Measured 2026-09-26 at 10:45:09: seven requests from a real browser got a
# 502 from 127.0.0.1:3001 in that second.
#
# With them, Caddy dials the SAME upstream again every 250 ms for up to 30 s.
# The request waits and then succeeds. It does not fail.
#
# ⚠️ What it retries, and what it does not:
#   • A DIAL failure only (connection refused). The upstream never got the
#     request, so a retry is safe for POST too. Caddy does not retry a request
#     the upstream has already begun to answer.
#   • An open stream (chat, SSE, a websocket) that the restart cuts is NOT
#     retried. The browser sees the stream end, as it did before this change.
#   • A 500 that the upstream returns is an answer, not a dial failure, and it
#     is passed to the client as it is.
# 30 s is longer than the gateway's measured cold start (15 to 23 s), so a
# direct API client also waits instead of getting a 502.
#
# ⚠️ `admin off` means `systemctl reload caddy` CANNOT work: reload talks to the
# admin endpoint. The apply therefore RESTARTS Caddy, and ONLY when this file
# differs from the installed copy. A restart drops open connections, so the
# apply must never restart Caddy on a deploy that did not change it.
# Fence: tests/unit/test_deploy_serialize.py (the H-60 section).
{
	# Set an email for ACME registration (Let's Encrypt expiry alerts go here).
	email ops@fracktal.in
	admin off
}

# --- Gateway API (FastAPI) ---
api.metorite.com {
	@internal path /internal/*
	respond @internal 404
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Real-IP {remote_host}
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

# --- Control Plane UI (Next.js) ---
app.metorite.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3001 {
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

# --- Marketing apex (WS-33) ---
metorite.com {
	encode zstd gzip
	root * /opt/acb/app/site
	file_server
}

www.metorite.com {
	redir https://metorite.com{uri} permanent
}

# Operator console (CP-8) — staff-only cross-org surface. Session gate is the
# app's own login (OPERATOR_CONSOLE_STAFF_SECRET, constant-time, httpOnly
# Secure cookie). Public exposure = owner decision 2026-08-23 (was SSH-tunnel).
operator.metorite.com {
	reverse_proxy 127.0.0.1:3002 {
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}
