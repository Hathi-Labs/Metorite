[Unit]
Description=Metorite agent edge (MCP for outside agents, WS-55)
# Spec: project-docs/specs/external_agent_access.md §15.3 EA-10a.
#
# The public door for outside agents. Caddy proxies mcp.metorite.com to this
# unit on loopback. The edge calls the gateway on loopback with a signed
# request (spec §10.1), so it needs the gateway, but a gateway restart must
# not restart it. So this unit uses After= and no Requires=.
#
# ⚠️ The deploy installs this file and starts NOTHING. scripts/vps_apply.sh
# restarts the edge only when the unit is ENABLED. Enabling it is an owner
# act (gate `deploy`), after the edge env file below exists.
After=network-online.target acb-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=acb
# Settings reads env_file=".env" relative to this directory. So the edge loads
# ITS OWN env file, never the root /opt/acb/app/.env, which holds the internal
# bearer. The drop-in 50-hardening.conf also hides the root .env (EA3-1).
WorkingDirectory=/opt/acb/app/apps/services/agent_edge
Environment=PATH=/opt/acb/app/.venv/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/opt/acb/app/apps/services/agent_edge/.env
# The venv binary, not `uv run`: `uv run` syncs the venv, and the sandbox
# makes the venv read-only. 8091 is free (the Customer Console holds 8090).
ExecStart=/opt/acb/app/.venv/bin/uvicorn agent_edge.app:app --host 127.0.0.1 --port 8091
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
