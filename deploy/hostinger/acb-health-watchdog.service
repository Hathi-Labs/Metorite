[Unit]
# Metorite health watchdog — see health-watchdog.sh for the rationale.
# Oneshot unit driven by acb-health-watchdog.timer.
Description=Metorite health watchdog (check + self-heal services)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs as root: needs systemctl restart, iptables/ufw and fail2ban reads.
User=root
# Invoked through bash on purpose: a checkout that loses the executable bit
# (Windows contributors, archive exports) would otherwise make ExecStart fail
# with a bare "Permission denied" and the watchdog would silently never run.
ExecStart=/bin/bash /opt/acb/app/deploy/hostinger/health-watchdog.sh
# A restart attempt plus probes can legitimately take a while; do not let a
# wedged service hang the timer forever.
TimeoutStartSec=600
