# Files that are executed on the Linux VPS must keep LF endings regardless of
# the contributor's platform or core.autocrlf setting. A CRLF shebang fails at
# runtime with the famously unhelpful "bad interpreter: /usr/bin/env bash^M",
# and a CRLF systemd unit is parsed but silently misbehaves.
*.sh            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
# systemd drop-ins (WS-49 BH-7). A CRLF line here is parsed wrong too.
deploy/hostinger/**/*.conf text eol=lf
deploy/hostinger/caddy/Caddyfile text eol=lf
deploy/hostinger/known_hosts text eol=lf
# WS-49 BH-6: the root copy lists. root_env.sh reads the names file as root.
deploy/hostinger/root_lib_files.txt text eol=lf
deploy/hostinger/root_env_names.txt text eol=lf
