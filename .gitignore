*.py[cod]
*.egg-info/
.venv/
.uv-cache/
dist/
build/
# Re-include Next.js app route directories named "build" inside src/app
!workbench/control_plane/src/app/build/
!workbench/control_plane/src/app/build/**
# Re-include the App Workshop's platform-owned T2 build script (not a build
# artifact — versioned source the app-builder agent shells out to)
!apps/agents/agent-app-builder/build/
!apps/agents/agent-app-builder/build/**

# Env / secrets
.env
.env.*
!.env.example
infra/.env
infra/litellm/litellm.env   # Auto-generated by deploy.sh — contains real keys
infra/litellm/tier_overrides.yaml  # Settings UI tier changes — survives deploys
*.pem
*.key
secrets/

# Local reference checkouts (e.g. upstream inbox-zero for parity work)
reference/

# IDE
.vscode/mcp.json
.idea/
*.swp
.DS_Store

# impeccable design-hook local cache (per-checkout, regenerated on scan)
.impeccable/

