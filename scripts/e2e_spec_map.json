      "specs": ["integrations-agents.spec.ts", "agent-change-access.spec.ts", "connect-authorize.spec.ts"]
    },
    "assistant": {
      "paths": [
        "src/app/chat/", "src/app/api/chat/", "src/app/api/agent/", "src/app/api/agent-access/", "src/app/api/agent-guidance/",
        "src/components/AgentChat", "src/components/AgentAvatar", "src/components/AgentStatusBar", "src/components/AssistantToggle",
        "src/components/Chat", "src/components/Card", "src/components/GenerativeUI", "src/components/GenUi", "src/components/GenUIFallback",
        "src/components/genUITemplates", "src/components/Confirmation", "src/components/Elicitation", "src/components/PlanCardBody",
        "src/components/AppRequestCard", "src/components/AskPin", "src/components/MarkdownMessage", "src/components/MessageBubble",
        "src/components/Thinking", "src/hooks/useAgentChat", "src/lib/markdown",
        "src/lib/chat", "src/lib/card", "src/lib/genUi", "src/lib/ask", "src/lib/assistant", "src/lib/confirmation",
        "src/lib/agent", "src/lib/appRequest", "src/lib/railSessions"
      ],
      "specs": [
        "chat*.spec.ts", "approval-stack.spec.ts", "askbar-clearance.spec.ts", "assistant-motion.spec.ts",
        "genui-option-picker.spec.ts", "interview-offer-start.spec.ts", "plan-card.spec.ts",
        "glass-rail-menu.spec.ts", "phone-bar-always.spec.ts", "email-chat-*.spec.ts",
        "email-held-send.spec.ts", "email-redraft.spec.ts", "one-assistant-email.spec.ts",
        "agent-questions*.spec.ts", "agent-runs.spec.ts"
      ]
    },
    "home": {
      "paths": ["src/app/page.tsx", "src/app/api/brief/", "src/components/BreathingCharacter", "src/components/WelcomeDialog"],
      "specs": [
        "my-day-feed.spec.ts", "myday-peek.spec.ts", "brief-card.spec.ts", "buddy-hello.spec.ts",
        "chat-starter-pills.spec.ts", "guide-*.spec.ts", "sidebar-row-counts.spec.ts"
      ]
    },
    "artifacts": {
      "paths": [
        "src/app/artifacts/", "src/app/apps/", "src/app/api/artifacts/", "src/app/api/apps/",
        "src/components/Artifact", "src/lib/artifact", "src/lib/compile"
      ],
      "specs": ["react-artifact.spec.ts", "untrusted-html.spec.ts", "custom-app-bridge.spec.ts", "sandbox-theming.spec.ts", "theming.spec.ts"]
    },
    "other-apps": {
      "paths": [
        "src/app/people/", "src/app/whatsapp/", "src/app/notes/", "src/app/memory/", "src/app/workflows/",
        "src/app/studio/", "src/app/agents/", "src/app/approvals/", "src/app/observability/", "src/app/inbox/",
        "src/app/dashboard/", "src/app/centers/", "src/app/access/", "src/app/build/", "src/app/calendar/",
        "src/app/signin/", "src/app/signup/", "src/app/oauth/",
        "src/app/api/people/", "src/app/api/whatsapp/", "src/app/api/notes/", "src/app/api/memory/",
        "src/app/api/workflows/", "src/app/api/studio/", "src/app/api/observability/", "src/app/api/calendar/",
        "src/app/api/billing/", "src/app/api/admin/",
        "src/components/studio/", "src/components/room/", "src/components/profile/", "src/components/calendar/",
        "src/lib/studio/", "src/lib/deploy/", "src/lib/charts/"
      ],
      "specs": [
        "shell-presets.spec.ts", "rail-rows.spec.ts", "untrusted-html.spec.ts",
        "agent-questions-doors.spec.ts", "app-title-bar.spec.ts"
      ]
    }
  }
}
