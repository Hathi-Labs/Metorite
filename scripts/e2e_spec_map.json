      "specs": ["crm-*.spec.ts"]
    },
    "settings": {
      "paths": [
        "src/app/settings/", "src/app/api/settings/", "src/app/api/org/", "src/app/api/accounts/",
        "src/components/SettingsHeader", "src/components/AccountSwitcher", "src/components/AccountStateBanner",
        "src/components/OrgBrandLockup", "src/components/OrgLinkGate", "src/components/SidebarFold",
        "src/lib/account", "src/lib/orgBranding", "src/lib/orgLink", "src/lib/sidebarFold", "src/lib/railFold"
      ],
      "specs": [
        "account-switcher.spec.ts", "appearance-per-account.spec.ts", "org-*.spec.ts", "command-bar-apps.spec.ts",
        "app-title-bar.spec.ts", "shell-*.spec.ts", "sidebar-*.spec.ts"
      ]
    },
    "integrations": {
