[Unit]
Description=Metorite reaper: stop orphan dev stacks, remove merged worktrees, list left loops (CIV-14j, CIV-16)
# Add --apply to ExecStart to stop the left wait loops and test runs too.

[Service]
Type=oneshot
WorkingDirectory=%h/Metorite
ExecStart=/usr/bin/python3 %h/Metorite/scripts/reaper.py
