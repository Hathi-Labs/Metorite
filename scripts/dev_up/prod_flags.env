# Production's feature switches, for the local stack (scripts/dev_up.sh).
#
# Source: the flags.env that the nightly staging export carries
# (scripts/staging_export.sh). It holds switch values only, never a key, a
# token or a URL. Read from the staging box on 2026-10-30.
#
# Refresh it with:  bash scripts/dev_up.sh --refresh-flags
#
# dev_up.sh does NOT apply this file as it is. It applies the same two rules
# that scripts/staging_refresh.sh applies, so a switch that reaches a person or
# a third party (mail, WhatsApp, push, invites, sign-up, sync) is held OFF.
# Format: <scope>:<NAME>=<value>. Scope `root` goes to the gateway, scope
# `workbench` goes to the web app.
root:MEM0_ENABLED=false
root:GRAPHITI_ENABLED=false
root:EMAIL_BACKGROUND_SYNC_ENABLED=true
root:WHATSAPP_SEMANTIC_SEARCH_ENABLED=false
root:WHATSAPP_BRIDGE_ENABLED=0
root:SELF_SERVE_SIGNUP_ENABLED=true
root:EMAIL_SYNC_ENABLED=true
root:WORKFLOW_SCHEDULER_ENABLED=false
root:IDENTITY_CUTOVER=true
root:ACB_GRAPH_TENANT_BIND=true
root:MEETING_BOT_ENABLED=1
root:CONSOLE_BOOTSTRAP_ENABLED=true
root:NEXT_PUBLIC_TASKS_LENS=1
root:TASKS_LENS=1
root:ROUTER_SERVING_ENABLED=true
root:DECIDE_ENABLED=true
root:WHATSAPP_ASSISTANT_ENABLED=true
root:CRM_ENABLED=true
root:MY_DAY_LOOP_ENABLED=true
root:AGENT_ACCESS_ENABLED=true
root:AGENT_ACCESS_WRITES_ENABLED=true
root:REACH_ENABLED=true
root:AGENT_RUNS_ENABLED=true
root:COMPANY_SEARCH_ENABLED=true
root:KNOWLEDGE_ENABLED=true
root:ASSISTANT_PROFILE_ENABLED=true
root:WEB_PUSH_ENABLED=true
workbench:SELF_SERVE_SIGNUP_ENABLED=true
workbench:CUSTOMER_CONSOLE_RESOLVE_ENABLED=true
workbench:EMAIL_OTP_ENABLED=true
workbench:MEMBER_INVITE_EMAIL_ENABLED=true
workbench:NEXT_PUBLIC_PROJECTS_CHAT=1
workbench:NEXT_PUBLIC_TASKS_LENS=1
workbench:NEXT_PUBLIC_PROJECTS_IMPORT=1
workbench:NEXT_PUBLIC_AI_TIER_ROUTING=1
workbench:ACCOUNT_SWITCHER_ENABLED=true
workbench:NEXT_PUBLIC_SHELL_BAR=1
workbench:NEXT_PUBLIC_SHELL_NAV=1
workbench:NEXT_PUBLIC_MY_DAY=1
workbench:NEXT_PUBLIC_SHELL_CHAT=1
workbench:NEXT_PUBLIC_MY_DAY_FEED=1
workbench:NEXT_PUBLIC_SHELL_DOCK=1
workbench:NEXT_PUBLIC_CHAT_FIRST=1
workbench:NEXT_PUBLIC_PROJECTS_MY_WORK=1
workbench:NEXT_PUBLIC_PROJECTS_COMPACT_CHROME=1
