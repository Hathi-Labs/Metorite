# ====== AI Company Brain — environment template ======
# Copy to .env (gitignored) and fill in real values. Never commit .env.

# --- LLM provider keys (used by gateway via litellm SDK) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GITHUB_TOKEN=

# --- Note Taker STT (spec: project-docs/specs/note_taker_app.md §3.4) ---
# Transcription routes through the platform's LiteLLM plumbing: the model is the
# `tier-stt` tier (infra/litellm/config.yaml, editable in Settings → Models),
# resolved and keyed exactly like the chat tiers. Default: groq/whisper-large-v3-turbo.
# Optional override — a tier alias or a concrete provider/model (e.g. openai/whisper-1):
NOTES_STT_MODEL=
# Deepgram — the paid STT provider that NAMES SPEAKERS (diarization). Set this,
# then pick a Deepgram model (nova-3 / nova-2) for the STT tier in Settings → Models.
# Live captions during recording also use this key (browser-direct via a
# short-lived token the gateway mints) — the master key needs key-management
# scope for that; without it, recording still works via the batch path.
DEEPGRAM_API_KEY=
# Optional — skip a Deepgram /projects lookup when minting live-caption tokens.
DEEPGRAM_PROJECT_ID=
# Where meeting audio lands on disk (relative to the gateway working dir).
NOTES_MEDIA_DIR=data/notes_media

# --- Local inference (vLLM) ---
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen3-8B-Instruct

# --- Gateway LLM routing (via litellm SDK directly — no separate proxy) ---
LITELLM_MASTER_KEY=sk-local-dev-change-me
LITELLM_BASE_URL=http://127.0.0.1:8080

# --- Provider-key encryption (H-13) ---
#
# LOAD-BEARING, and it was missing from this template entirely. Every provider
# credential in the `provider_keys` table is Fernet-encrypted with a key
# stretched from this value (`acb_common/settings.py`, `infra/postgres/08`).
# The key itself is never stored in the database.
#
# The README says "cp .env.example .env — then set ACB_MASTER_KEY", and there
# was no line here to set. Lose this value and every stored provider key
# becomes undecryptable ciphertext.
ACB_MASTER_KEY=

# --- Postgres (entity graph + pgvector + AGE) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=acb
POSTGRES_USER=acb
POSTGRES_PASSWORD=acb_dev_change_me
DATABASE_URL=postgresql+psycopg://acb:acb_dev_change_me@localhost:5432/acb

# --- Redis (event bus + GPTCache backing store) ---
REDIS_URL=redis://localhost:6379/0

# --- Mem0 — episodic memory (per-user cross-session facts) ---
# Requires: Postgres + pgvector (mem0ai creates its own table automatically).
# Set to true to enable automatic memory extraction and context injection.
MEM0_ENABLED=false

# --- Graphiti — bi-temporal knowledge graph (entity timelines) ---
# Requires: Neo4j running (docker compose --profile memory up -d neo4j).
# Extracts time-stamped entity facts from conversations and ingestion events.
GRAPHITI_ENABLED=false
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Langfuse (self-hosted observability) ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Source-of-truth systems ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_REGION=in

ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

# --- Google Workspace (Gmail + Calendar via DWD) ---
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-sa.json
GOOGLE_WORKSPACE_DOMAIN=fracktal.in
GOOGLE_PUBSUB_TOPIC=

# --- Email OAuth (Gmail + Microsoft 365 individual OAuth) ---
# Gmail OAuth 2.0 — requires a Google Cloud project with Gmail API enabled
# Redirect URI: https://<your-domain>/email/oauth/gmail/callback
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
# Microsoft 365 OAuth 2.0 — requires an Azure AD app registration
# Redirect URI: https://<your-domain>/email/oauth/microsoft/callback
MSFT_OAUTH_CLIENT_ID=
MSFT_OAUTH_CLIENT_SECRET=

# --- Inbound email (aiosmtpd SMTP receiver) ---
# SMTP server for receiving inbound emails directly (free, no vendor needed).
# Point your domain's MX record or email forwarding at this host:port.
EMAIL_INBOUND_HOST=127.0.0.1
EMAIL_INBOUND_PORT=10025
EMAIL_INBOUND_ACCOUNT_ID=

# --- Background email sync scheduler ---
# Set to true to auto-start per-account sync loops on gateway startup.
# When false, sync only runs on manual POST /email/sync trigger.
EMAIL_BACKGROUND_SYNC_ENABLED=true

# --- WhatsApp Business Cloud API ---
# Per-number credentials are entered + encrypted via the Connect wizard
# (/whatsapp/connect); these globals configure the shared webhook + onboarding.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Webhook verify token you also paste into Meta → WhatsApp → Configuration. If
# left blank, the Connect wizard generates a per-account token instead.
WHATSAPP_VERIFY_TOKEN=
# App Secret (Meta app → Settings → Basic). REQUIRED in production — it verifies
# the X-Hub-Signature-256 HMAC on inbound webhooks; unset = signatures unverified.
WHATSAPP_APP_SECRET=
# Public HTTPS base URL of THIS gateway, e.g. https://api.your-domain.com — the
# Connect wizard shows "<this>/whatsapp/webhook" as the Meta Callback URL.
WHATSAPP_PUBLIC_URL=
# Optional: one-click "Continue with Facebook" Embedded Signup. Set both to
# unlock it (the connect page shows the manual wizard otherwise). WHATSAPP_APP_ID
# is the Meta app id; WHATSAPP_ES_CONFIG_ID is an Embedded Signup configuration id
# (Meta app → WhatsApp → Embedded Signup). The App Secret above is reused for the
# server-side code exchange. Requires the app to have Embedded Signup access.
WHATSAPP_APP_ID=
WHATSAPP_ES_CONFIG_ID=
# Optional: turn on the autonomous enrichment sweep (group summaries + voice-note
# transcription + semantic-search embedding backfill). Costs LLM/STT tokens.
WHATSAPP_ENRICHMENT=
WHATSAPP_ENRICHMENT_INTERVAL_SECS=900
# Optional: hybrid semantic search over history (needs migration 111 + the
# enrichment sweep to embed). Reuses the email embedding model.
WHATSAPP_SEMANTIC_SEARCH_ENABLED=false
# Optional: connect a PERSONAL number by QR (whatsmeow bridge, provider=whatsmeow)
# instead of the Cloud API. Point these at the whatsapp_bridge service (see
# apps/services/whatsapp_bridge). Unset = the "Personal WhatsApp" connect option
# reports the bridge as unreachable. NOTE: personal-number linking is outside
# WhatsApp's ToS — for a personal line at your own risk, not a business number.
WHATSAPP_BRIDGE_URL=http://localhost:8790
# Shared secret authenticating gateway ↔ bridge in both directions. MUST match the
# bridge's WHATSAPP_BRIDGE_SECRET. Leave blank only for local dev.
WHATSAPP_BRIDGE_SECRET=
# When the bridge runs on the SAME box (the VPS deploy sets these automatically):
# whether the deploy builds + runs the bridge systemd service (opt out with 0);
# the bridge's own listen addr (localhost only); where it reaches the gateway; and
# its sqlite session store. Only needed if you self-host the bridge co-located.
WHATSAPP_BRIDGE_ENABLED=1
WHATSAPP_BRIDGE_ADDR=127.0.0.1:8790
WHATSAPP_BRIDGE_GATEWAY_URL=http://localhost:8080
WHATSAPP_BRIDGE_STORE=/opt/acb/data/whatsapp_bridge/bridge-store.db
# On-link history backfill: true (default) requests ~1 year of recent history on
# pairing (like WhatsApp Desktop); false gives ~3 months. Historical messages are
# persisted + triaged but never auto-replied to. ~1yr reliable, ~3yr ceiling.
WHATSAPP_BRIDGE_FULL_HISTORY=true
WHATSAPP_BRIDGE_FULL_HISTORY_DAYS=365
# Voice calls (WhatsApp → Calls). Each call's audio is recorded here as 16 kHz
# mono WAV — the format the note-taker STT already consumes. Blank disables
# recording; calls still connect. Ended calls stay queryable for REAP_MINS.
WHATSAPP_BRIDGE_CALL_RECORD_DIR=/opt/acb/data/whatsapp_bridge/call-recordings
WHATSAPP_BRIDGE_CALL_REAP_MINS=60
# Recording runs ~115 MB per hour of call, so audio is swept after this many
# days. 0 keeps it forever — only set that if you've sized the disk for it.
WHATSAPP_BRIDGE_CALL_RETENTION_DAYS=7
# Verbosity of the calling library's own media diagnostics. `info` surfaces the
# lines that diagnose a connected-but-silent call (relay bind, first RTP, SRTP
# auth); `debug` adds the full per-packet trace.
WHATSAPP_BRIDGE_CALL_LOG_LEVEL=info

# --- Gateway / auth ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_SESSION_SECRET=change-me-dev-only
GOOGLE_SSO_CLIENT_ID=
GOOGLE_SSO_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=fracktal.in
# SERVICE IDENTITY token — shared secret between the Next.js proxy and the
# gateway. Proves a caller IS the platform and grants full authority, so it
# must be DIFFERENT from LITELLM_MASTER_KEY: that key is handed to every
# agent's /v1 client, and while the two were one value any agent could
# authenticate as the platform and call /admin/*. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leaving it blank still falls back to LITELLM_MASTER_KEY so an un-migrated
# deployment keeps working — but the gateway then warns on every resolution
# because the separation does not exist. Set it.
GATEWAY_INTERNAL_TOKEN=
# Shared secret for POST /agent/webhook/{source}, signed as
# X-CC-Signature: sha256=<hmac-sha256 of the raw body>. This endpoint STARTS
# AN AGENT RUN, so it fails closed: with no secret set it returns 503 rather
# than accepting unsigned calls. Per-source overrides take precedence, e.g.
# AGENT_WEBHOOK_SECRET_ZOHO, so one leaked integration cannot trigger
# every agent (dashes in a source name become underscores).
AGENT_WEBHOOK_SECRET=
# Recovery hatch ONLY. When the org access tables (migration 128) are missing,
# members resolve to NO ACCESS by default. Set to 1 to degrade to the legacy
# executive/employee mapping instead while you fix the migration, then unset.
ACCESS_LEGACY_FALLBACK=
# Comma-separated list of executive emails for role assignment.
# Everyone else defaults to "employee".
EXECUTIVE_EMAILS=

# --- VPS SSH access (for cloud agents to manage the VPS directly) ---
# VPS_SSH_KEY: base64-encoded private key — generate with: base64 -w0 ~/.ssh/your_key
VPS_HOST=
VPS_USER=root
VPS_SSH_PORT=22
VPS_PASSWORD=
VPS_SSH_KEY=

# --- Runtime ---
ACB_ENV=dev
LOG_LEVEL=INFO

# ====== Phase 0.5 — Skill Workbench ======

# --- OpenHands self-hosted sandbox (deploy/openhands/docker-compose.yml) ---
OPENHANDS_PORT=3000
OPENHANDS_DEFAULT_MODEL=tier-balanced
GITHUB_PAT=

# --- Control Plane (workbench/control_plane, Next.js on :3001) ---
# Path overrides (defaults resolve to ./skills relative to the control plane cwd)
SKILLS_ROOT=
# URLs surfaced into the browser via NEXT_PUBLIC_*
NEXT_PUBLIC_OPENHANDS_URL=http://localhost:3000

# The Tasks/Calendar store cutover (WS-39, D53). BOTH or NEITHER - see
# docs/TASKS_LENS.md. The gateway half and the browser half must agree,
# and /version reports `tasks_lens` so you can see which the box believes.
#
# Do NOT enable before the S3b backfill has run. gtd_items still holds
# every existing task, so turning these on early does not break the app -
# it EMPTIES it, on a 200, with no error to notice.
NEXT_PUBLIC_TASKS_LENS=0
TASKS_LENS=0

# NextAuth v5 (Google SSO). Leave blank in dev to disable auth entirely.
# Set all three to enable. In production AUTH_SECRET must be a strong random
# string of 32 characters or more.
#
# ⚠️ AUTH_ALLOWED_DOMAIN was REMOVED here (H-13). Nothing in the tree read it —
# it appeared in this file and nowhere else — and it hardcoded ONE customer's
# domain into the template every fresh box copies. Metorite is multi-tenant
# from customer #1 (D15), so a single allowed domain is the wrong shape as well
# as dead.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Gateway URL for Next.js API proxy routes.
#
# ⚠️ 8080, not 8000 (H-13). The gateway's own systemd unit runs
# `uvicorn … --port 8080` (`deploy/hostinger/acb-gateway.service`), and
# COPILOT_LLM_BASE_URL two lines below already points there — this line
# contradicted its neighbour. 8000 is the LOCAL-dev convention from the README
# and remains the in-code fallback.
GATEWAY_BASE_URL=http://127.0.0.1:8080

# Gateway /v1 endpoint for LLM calls (uses litellm SDK, NOT a separate proxy)
COPILOT_LLM_BASE_URL=http://127.0.0.1:8080/v1
COPILOT_LLM_API_KEY=
# Copilot CLI's own model env. MUST be a valid gateway tier alias
# (tier-fast|tier-balanced|tier-powerful) — never a bare "tierN-provider" name,
# which no tier resolves to. App agents/chats use COPILOT_CHAT_MODEL below; this
# only affects native Copilot CLI sessions. Keep the two consistent.
COPILOT_MODEL=tier-balanced

# Default model for all Copilot SDK agents/chats (LiteLLM gateway tier alias).
COPILOT_CHAT_MODEL=tier-balanced
# BYOK-by-default: route EVERY Copilot SDK agent through the LiteLLM gateway and
# normalize bare model names (e.g. an .agent.md "claude-sonnet-4-5") to
# COPILOT_CHAT_MODEL. Set false to let bare names hit api.githubcopilot.com.
COPILOT_BYOK_DEFAULT=true
COPILOTKIT_TELEMETRY_DISABLED=true

# Default output-token ceiling applied by the gateway's /v1 endpoint whenever a
# caller omits max_tokens. THIS is the real output cap for the whole platform:
# /v1 is the choke point every agent runtime POSTs through, and the Copilot SDK
# never sends max_tokens (its wire protocol has no such field). Raise this if an
# agent's output — or a long tool-call argument — is being cut off mid-way
# (symptom: a tool call fails with "Unterminated string in JSON at position N",
# or a turn ends with no text). Code default: 32000.
#GATEWAY_DEFAULT_MAX_OUTPUT_TOKENS=32000

# NOTE: COPILOT_MAX_OUTPUT_TOKENS is a NO-OP and is kept only for
# backward-compat. The Copilot SDK's create/resume-session wire protocol has no
# max_tokens field, so neither this env var nor the SessionConfig max_tokens we
# set ever reaches the model. Use GATEWAY_DEFAULT_MAX_OUTPUT_TOKENS above.
#COPILOT_MAX_OUTPUT_TOKENS=  # dead knob — does nothing

# Infinite-session compaction policy for Copilot SDK agents.
# default: disabled for BYOK models (backend window estimate is wrong),
#          relaxed thresholds (bg=0.92, buf=0.99) for Copilot-native models.
# off: disable backend compaction entirely (use when C2 assembly is the sole
#      context manager).
# default: leave SDK defaults untouched (0.80/0.95 — not recommended for BYOK).
#COPILOT_INFINITE_SESSIONS=
#COPILOT_COMPACTION_THRESHOLD=0.92
#COPILOT_BUFFER_THRESHOLD=0.99

# workspace_root for agent config.json: set $METORITE_ROOT in your .env
# to point a development agent at the Metorite repo so shell commands
# and file edits run in the right directory.
#METORITE_ROOT=/path/to/Metorite

# ── Telemetry (HH-3) ────────────────────────────────────────────────────────
# When set, LiteLLM registers its OpenTelemetry callback and exports LLM-call
# traces there (e.g. http://127.0.0.1:4318). Leave unset to export nothing.
# Re-enable MAF's own instrumentation with ENABLE_INSTRUMENTATION=1 only after
# this endpoint exists.
#OTEL_EXPORTER_OTLP_ENDPOINT=
# Per-LLM-call token/cache usage is always logged (acb_llm.usage); set to 1 to
# also append an audit_event row per call.
LLM_USAGE_AUDIT=0
