{
  "studio": 1,
  "id": "support-desk",
  "name": "Support desk",
  "purpose": "Log customer tickets, work the queue and close them.",
  "team": "support",
  "objects": [
    {
      "name": "ticket",
      "fields": [
        {
          "key": "subject",
          "type": "text",
          "required": true
        },
        {
          "key": "customer",
          "type": "text"
        },
        {
          "key": "contact_email",
          "type": "email"
        },
        {
          "key": "channel",
          "type": "select",
          "options": [
            "mail",
            "whatsapp",
            "phone"
          ]
        },
        {
          "key": "priority",
          "type": "select",
          "options": [
            "low",
            "normal",
            "high"
          ]
        },
        {
          "key": "assignee",
          "type": "person"
        },
        {
          "key": "due",
          "type": "datetime"
        },
        {
          "key": "status",
          "type": "select",
          "hot": true,
          "options": [
            "new",
            "open",
            "waiting",
            "solved"
          ]
        },
        {
          "key": "notes",
          "type": "longText"
        },
        {
          "key": "files",
          "type": "file",
          "many": true
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "find",
      "uses": "object:ticket.list"
    },
    {
      "id": "ticket_get",
      "uses": "object:ticket.get"
    },
    {
      "id": "ticket_create",
      "uses": "object:ticket.create"
    },
    {
      "id": "ticket_update",
      "uses": "object:ticket.update"
    },
    {
      "id": "ticket_delete",
      "uses": "object:ticket.delete"
    },
    {"id": "ticket_aggregate", "uses": "object:ticket.aggregate"}
  ],
  "views": [
    {
      "id": "board",
      "block": "board",
      "source": {
        "object": "ticket"
      },
      "group_by": "status",
      "card": {
        "title": "subject",
        "meta": [
          "customer",
          "assignee"
        ]
      }
    },
    {
      "id": "list",
      "block": "table",
      "source": {
        "object": "ticket"
      },
      "columns": [
        "subject",
        "customer",
        "priority",
        "assignee",
        "due",
        "status"
      ]
    },
    {"id": "mine", "block": "table", "title": "My tickets", "source": {"object": "ticket", "args": {"filter": [{"field": "assignee", "op": "eq", "value": "me"}]}}, "columns": ["subject", "customer", "priority", "assignee", "due", "status"]},
    {"id": "open", "block": "table", "title": "Open tickets", "source": {"object": "ticket", "args": {"filter": [{"field": "status", "op": "ne", "value": "solved"}]}}, "columns": ["subject", "customer", "priority", "assignee", "due", "status"]},
    {"id": "open_total", "block": "stat", "title": "Open tickets", "source": {"object": "ticket", "action": "ticket_aggregate", "args": {"filter": [{"field": "status", "op": "ne", "value": "solved"}], "measures": [{"op": "count"}], "good": "down"}}},
    {"id": "by_status", "block": "chart", "title": "By status", "source": {"object": "ticket", "action": "ticket_aggregate", "args": {"kind": "donut", "group_by": {"field": "status"}, "measures": [{"op": "count"}]}}},
    {
      "id": "ticket_page",
      "block": "detail",
      "object": "ticket",
      "fields": [
        "subject",
        "customer",
        "contact_email",
        "channel",
        "priority",
        "assignee",
        "due",
        "status",
        "notes",
        "files"
      ]
    },
    {
      "id": "new",
      "block": "form",
      "object": "ticket",
      "fields": [
        "subject",
        "customer",
        "contact_email",
        "channel",
        "priority",
        "assignee",
        "due",
        "notes"
      ],
      "submit": "ticket_create"
    }
  ],
  "skill": {
    "description": "Use for support tickets: log one, find one, see the queue.",
    "instructions": "Ask for the subject and the customer first. Show the board card. Change a ticket only on the member's request.",
    "actions": [
      "object:ticket.create"
    ],
    "cards": [
      "board",
      "new"
    ]
  },
  "shell": {
    "jobs": [
      {
        "verb": "Log a ticket",
        "view": "new"
      }
    ],
    "needs": [
      {
        "object": "ticket",
        "where": {
          "assignee": "$me",
          "status": "open"
        }
      }
    ],
    "search": [
      "ticket"
    ]
  },
  "pages": [
    {"id": "dashboard", "title": "Dashboard", "cols": 2, "cells": [{"view": "open_total"}, {"view": "by_status"}]},
    {"id": "all", "title": "All tickets", "cols": 1, "cells": [{"view": "list"}], "side": {"view": "new"}},
    {"id": "mine", "title": "My tickets", "cols": 1, "cells": [{"view": "mine"}], "side": {"view": "new"}},
    {"id": "open", "title": "Open tickets", "cols": 1, "cells": [{"view": "open"}], "side": {"view": "new"}},
    {"id": "board", "title": "Board", "cols": 1, "cells": [{"view": "board"}], "side": {"view": "new"}}
  ],
  "nav": [
    {"title": "Tickets", "rows": [
      {"page": "dashboard", "icon": "LayoutDashboard", "label": "Dashboard"},
      {"page": "all", "icon": "List", "label": "All tickets"},
      {"page": "mine", "icon": "User", "label": "My tickets", "count": true},
      {"page": "open", "icon": "Inbox", "label": "Open tickets", "count": true},
      {"page": "board", "icon": "Kanban", "label": "Board"}
    ]}
  ]
}
